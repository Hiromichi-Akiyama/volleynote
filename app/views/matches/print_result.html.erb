<div class="container" style="max-width: 100%;">
    <div style="background: #28a745; color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
        <h1 style="margin: 0; color: white; font-size: 28px;">🏐 試合結果</h1>
        <div style="margin-top: 10px; font-size: 16px; opacity: 0.9;">
            出場選手: <%= @match_players_data.length %>名 (先発<%= @match.match_players.starting.count %>名 + ベンチ<%= @match.match_players.bench.count %>名)
            <br>印刷日時: <%= Time.current.strftime('%Y年%m月%d日 %H:%M') %>
        </div>
    </div>
    
    <div style="text-align: center; margin-bottom: 20px;" class="no-print">
        <button onclick="window.print()" class="btn">🖨️ 印刷</button>
        <button onclick="window.close()" class="btn btn-secondary">戻る</button>
    </div>
    
    <!-- MVP選出 -->
    <% if @mvp %>
        <div style="background: linear-gradient(135deg, #ffd700, #ffed4e); border-radius: 8px; padding: 20px; text-align: center; margin-bottom: 20px;">
            <h2 style="margin: 0 0 15px 0;">🏆 MVP</h2>
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">
                #<%= @mvp[:player].number %> <%= @mvp[:player].name %>
            </div>
            <div style="font-size: 16px; color: #6c757d; margin-bottom: 10px;">
                <%= @mvp[:player].position %>
            </div>
            <div style="font-size: 18px; font-weight: bold;">
                総合評価: <%= @mvp[:score].round(1) %>点
            </div>
        </div>
    <% end %>
    
    <!-- チーム統計 -->
    <div style="background: white; border-radius: 8px; padding: 15px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3>📈 チーム統計</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 15px 0;">
            <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; text-align: center; border: 1px solid #e9ecef;">
                <div style="font-size: 24px; font-weight: bold; color: #dc3545; margin-bottom: 5px;"><%= @team_stats[:spike_rate] %>%</div>
                <div style="font-size: 14px; color: #6c757d;">スパイク決定率</div>
            </div>
            <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; text-align: center; border: 1px solid #e9ecef;">
                <div style="font-size: 24px; font-weight: bold; color: #007bff; margin-bottom: 5px;"><%= @team_stats[:recv_rate] %>%</div>
                <div style="font-size: 14px; color: #6c757d;">サーブレシーブ成功率</div>
            </div>
            <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; text-align: center; border: 1px solid #e9ecef;">
                <div style="font-size: 24px; font-weight: bold; color: #28a745; margin-bottom: 5px;"><%= @team_stats[:serve_effect_rate] %>%</div>
                <div style="font-size: 14px; color: #6c757d;">サーブ効果率</div>
            </div>
        </div>
    </div>
    
    <!-- 選手成績テーブル -->
    <div style="background: white; border-radius: 8px; padding: 15px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <h3>📊 選手成績</h3>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th rowspan="2">背番号</th>
                        <th rowspan="2">名前</th>
                        <th rowspan="2">ポジション</th>
                        <th colspan="3">スパイク</th>
                        <th colspan="3">サーブレシーブ</th>
                        <th colspan="4">サーブ</th>
                        <th rowspan="2">総合評価</th>
                    </tr>
                    <tr>
                        <th>本数</th>
                        <th>決定</th>
                        <th>決定率</th>
                        <th>本数</th>
                        <th>成功</th>
                        <th>成功率</th>
                        <th>本数</th>
                        <th>効果</th>
                        <th>決定</th>
                        <th>効果率</th>
                    </tr>
                </thead>
                <tbody>
                    <% @match_players_data.each do |data| %>
                        <% player = data[:player] %>
                        <% stats = data[:stats] %>
                        <% rates = data[:rates] %>
                        <tr>
                            <td style="text-align: center; font-weight: bold;"><%= player.number %></td>
                            <td style="font-weight: bold;"><%= player.name %></td>
                            <td style="font-size: 12px;"><%= player.position %></td>
                            <td style="text-align: center;"><%= stats[:spike_attempts] %></td>
                            <td style="text-align: center;"><%= stats[:spike_kills] %></td>
                            <td style="text-align: center; font-weight: bold;"><%= rates[:spike_rate] %>%</td>
                            <td style="text-align: center;"><%= stats[:recv_attempts] %></td>
                            <td style="text-align: center;"><%= stats[:recv_successes] %></td>
                            <td style="text-align: center; font-weight: bold;"><%= rates[:recv_rate] %>%</td>
                            <td style="text-align: center;"><%= stats[:serve_attempts] %></td>
                            <td style="text-align: center;"><%= stats[:serve_effects] %></td>
                            <td style="text-align: center;"><%= stats[:serve_points] %></td>
                            <td style="text-align: center; font-weight: bold;"><%= rates[:serve_effect_rate] %>%</td>
                            <td style="text-align: center; font-weight: bold; color: #6f42c1;"><%= data[:total_score].round(1) %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- ポジション別最優秀選手 -->
    <% if @position_awards.any? %>
        <div style="background: white; border-radius: 8px; padding: 15px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <h3>🥇 ポジション別最優秀選手</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <% @position_awards.each do |position, award| %>
                    <div style="background: white; padding: 15px; border-radius: 6px; text-align: center; border: 2px solid #ffd700;">
                        <div style="font-weight: bold; color: #6c757d; margin-bottom: 5px;"><%= position %></div>
                        <div style="font-size: 18px; font-weight: bold;">#<%= award[:player].number %> <%= award[:player].name %></div>
                        <div style="font-size: 14px; color: #6c757d;">評価: <%= award[:score].round(1) %>点</div>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
    
    <div style="text-align: center; margin-top: 20px;" class="no-print">
        <button onclick="window.close()" class="btn">戻る</button>
    </div>
</div>